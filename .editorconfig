root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.vala]
max_line_length = 100

[*.py]
max_line_length = 88

[meson.build]
indent_size = 2

[*.xml]
indent_size = 2

[*.ui]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[debian/rules]
indent_style = tab
