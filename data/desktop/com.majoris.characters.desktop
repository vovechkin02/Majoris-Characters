[Desktop Entry]
Name=Characters
Comment=Browse and search Unicode characters
Exec=majoris-characters
Icon=com.majoris.characters
Terminal=false
Type=Application
Categories=GTK;Utility;
Keywords=Unicode;Character;Symbol;Emoji;
StartupNotify=true
DBusActivatable=true
Actions=picker;

[Desktop Action picker]
Name=Character Picker
Exec=majoris-characters --picker
